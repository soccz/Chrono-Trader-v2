[Unit]
Description=AETHER intraday scheduled run (refresh-db + intraday)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/20t/main/gan_t
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/mnt/20t/main/gan_t
ExecStart=/usr/bin/python3 /mnt/20t/main/gan_t/scripts/run_ops_job.py --job intraday --lock_timeout_sec 0 --limit 8 --lookback_days 1 --min_k 1 --market_budget 50 --refresh_top_n 30 --refresh_days 3 --timeout_sec_refresh 1200 --timeout_sec_infer 0
TimeoutStartSec=3600
