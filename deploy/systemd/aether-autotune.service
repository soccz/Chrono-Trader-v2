[Unit]
Description=AETHER ops auto-tune (writes analysis/ops_tuning.json)

[Service]
Type=oneshot
WorkingDirectory=/mnt/20t/main/gan_t
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/mnt/20t/main/gan_t
ExecStart=/usr/bin/python3 /mnt/20t/main/gan_t/scripts/auto_tune_ops.py --window_runs 42 --write
TimeoutStartSec=900
